<% content_for :title, 'Verify your number' %>
<% content_for :subtitle, "We texted a code to #{number_to_phone @contact.phone}" %>

<% content_for :card do %>
  <%= form_with url: verification_path, model: @contact, method: :post, data: { controller: :require } do |form| %>
    <%= form.fieldset do %>
      <%= form.label :pin_confirmation, '6-digit code' %>
      <%= form.pin_field :pin_confirmation, required: true %>
      <%= form.submit 'Confirm' %>
    <% end %>
  <% end %>

  <p class='small fg-2 mt-4 mb-0'>
    <%= link_to 'Use a different number', new_code_path %>
  </p>
<% end %>
